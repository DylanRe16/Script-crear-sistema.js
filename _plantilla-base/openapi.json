                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOfIReadOnlyListOfTurnoResponseDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/Turnos/pantalla-publica": {
      "get": {
        "tags": [
          "Turnos"
        ],
        "summary": "Endpoint optimizado para la pantalla pública de llamados en salas de espera.\nNo incluye datos personales confidenciales del ciudadano.",
        "parameters": [
          {
            "name": "limite",
            "in": "query",
            "description": "Cantidad máxima de últimos llamados a mostrar (por defecto 10).",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de turnos convocados y en atención.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOfIReadOnlyListOfTurnoPublicoDto"
                }
              }
            }
          }
        }
      }
    },
