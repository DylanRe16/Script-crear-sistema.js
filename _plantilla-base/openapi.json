{
  "openapi": "3.1.1",
  "info": {
    "title": "SGVTI API - Sistema de Registro y Control de Visitantes y Turnos",
    "description": "Especificación nativa OpenAPI 3.1.0 para la gestión de visitantes y turnos de atención de las Inspectorías del Trabajo.",
    "version": "v1 (OpenAPI 3.1.0)"
  },
  "servers": [
    {
      "url": "http://172.17.1.83/"
    }
  ],
  "paths": {
    "/api/Turnos": {
      "get": {
        "tags": [
          "Turnos"
        ],
        "summary": "Consulta los turnos del día con filtros opcionales de sala y estado.",
        "parameters": [
          {
            "name": "fecha",
            "in": "query",
            "description": "Fecha a consultar (formato AAAA-MM-DD, por defecto hoy).",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "sala",
            "in": "query",
            "description": "Filtrar por nombre de sala.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "estado",
            "in": "query",
            "description": "Filtrar por estado del turno.",
            "schema": {
              "$ref": "#/components/schemas/EstadoTurno"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de turnos correspondientes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOfIReadOnlyListOfTurnoResponseDto"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Turnos"
        ],
        "summary": "Registra la llegada de un visitante y genera su número de turno correlativo.",
        "requestBody": {
          "description": "Token de cancelación.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TurnoCreateDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/TurnoCreateDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/TurnoCreateDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOfTurnoResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOfTurnoResponseDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/Turnos/{id}": {
      "get": {
        "tags": [
          "Turnos"
        ],
        "summary": "Obtiene un turno específico por su identificador.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador único del turno.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOfTurnoResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOfTurnoResponseDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/Turnos/cola-espera": {
      "get": {
        "tags": [
          "Turnos"
        ],
        "summary": "Visualiza la cola de turnos en espera para ser llamados, ordenados por prioridad y llegada.",
        "parameters": [
          {
            "name": "sala",
            "in": "query",
            "description": "Filtro opcional por sala de atención.",
            "schema": {
              "type": "string"
