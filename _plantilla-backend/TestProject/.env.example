# ═══════════════════════════════════════════════════════════════════════════
# PlantillaBackend Backend — Plantilla de Variables de Entorno (.env)
# ═══════════════════════════════════════════════════════════════════════════
# Instrucciones:
# 1. Copia este archivo como '.env' en la carpeta del backend.
# 2. Ajusta las credenciales según el entorno (desarrollo o producción).
# 3. El archivo '.env' real jamás debe subirse a Git (ya está en .gitignore).
# ═══════════════════════════════════════════════════════════════════════════

# ─── 1. Base de Datos (PostgreSQL) ──────────────────────────────────────────
# Cadena de conexión principal. En .NET se usa '__' para representar secciones anidadas.
ConnectionStrings__DefaultConnection="Host=10.46.1.93;Port=5432;Database=Prueba;Username=postgres;Password=postgres;Search Path=PlantillaBackend,public"

# ─── 2. Seguridad y Tokens JWT ──────────────────────────────────────────────
# Clave simétrica para firmar los tokens (mínimo 32 caracteres seguros en producción)
JwtSettings__SecretKey="PlantillaBackend_SuperSecretSecurityKey_Minpptrassi_2026_PostgreSQL_Secure_Key_!#"
JwtSettings__Issuer="PlantillaBackend.Api"
JwtSettings__Audience="PlantillaBackend.Client"
JwtSettings__ExpirationHours="8"

# ─── 3. Contraseña por Defecto (Restablecimiento Administrativo) ────────────
SecuritySettings__DefaultResetPassword="Trabajo*2026"

# ─── 4. Servidor Kestrel y Enrutamiento ──────────────────────────────────────
# Subruta base para la API
PathBase="/PlantillaBackend/api"

# Entorno: Development | Production
ASPNETCORE_ENVIRONMENT="Development"

# Puerto y host de escucha Kestrel (opcional)
# ASPNETCORE_URLS="http://0.0.0.0:5000"

